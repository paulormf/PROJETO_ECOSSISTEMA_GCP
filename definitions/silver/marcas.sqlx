config {
  type: "table",
  schema: `${dataform.projectConfig.vars.environment}_silver`,
  name: "marcas",
  tags: ["silver", "product-catalog"],
  assertions: {
    uniqueKey: ["marca_id"]
  }
}

SELECT
  marca_id,
  nome_marca,
  criado_em,
  ingested_at AS source_ingested_at,
  run_id AS source_run_id
FROM ${ref(dataform.projectConfig.vars.environment + "_bronze", "marcas")}
