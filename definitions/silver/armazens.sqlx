config {
  type: "table",
  schema: `${dataform.projectConfig.vars.environment}_silver`,
  name: "armazens",
  tags: ["silver", "inventory"],
  assertions: {
    uniqueKey: ["armazem_id"]
  }
}

SELECT
  armazem_id,
  nome_armazem,
  cidade,
  estado,
  criado_em,
  ingested_at AS source_ingested_at,
  run_id AS source_run_id
FROM ${ref(dataform.projectConfig.vars.environment + "_bronze", "armazens")}
