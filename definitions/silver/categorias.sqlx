config {
  type: "table",
  schema: `${dataform.projectConfig.vars.environment}_silver`,
  name: "categorias",
  tags: ["silver", "product-catalog"],
  assertions: {
    uniqueKey: ["categoria_id"]
  }
}

SELECT
  categoria_id,
  categoria_pai_id,
  nome_categoria,
  criado_em,
  ingested_at AS source_ingested_at,
  run_id AS source_run_id
FROM ${ref(dataform.projectConfig.vars.environment + "_bronze", "categorias")}
