config {
  type: "incremental",
  schema: "dev_silver",
  name: "eventos_clientes",
  uniqueKey: ["evento_id"],
  tags: ["silver", "customer-events", "pii-protected"],
  bigquery: {
    partitionBy: "DATE(ocorrido_em)",
    clusterBy: ["cliente_id", "produto_id", "tipo_evento"]
  },
  assertions: {
    uniqueKey: ["evento_id"]
  }
}

SELECT
  evento_id,
  cliente_id,
  sessao_id,
  tipo_evento,
  produto_id,
  pedido_id,
  tipo_dispositivo,
  origem,
  dados_evento IS NOT NULL AND TRIM(dados_evento) <> '' AS possui_dados_evento,
  ocorrido_em,
  ingested_at AS source_ingested_at,
  run_id AS source_run_id
FROM ${ref("dev_bronze", "eventos_clientes")}
${when(
  incremental(),
  `WHERE ingested_at >= (
    SELECT COALESCE(MAX(source_ingested_at), TIMESTAMP("1970-01-01"))
    FROM ${self()}
  )`,
  ""
)}
