config {
  type: "incremental",
  schema: `${dataform.projectConfig.vars.environment}_silver`,
  name: "pedidos",
  uniqueKey: ["pedido_id"],
  tags: ["silver", "fact-orders"],
  bigquery: {
    partitionBy: "DATE(realizado_em)",
    clusterBy: ["cliente_id", "status_pedido"]
  },
  assertions: {
    uniqueKey: ["pedido_id"]
  }
}

SELECT
  pedido_id,
  cliente_id,
  endereco_cobranca_id,
  endereco_entrega_id,
  status_pedido,
  canal_venda,
  moeda,
  subtotal,
  desconto_total,
  frete_total,
  total_pedido,
  realizado_em,
  atualizado_em,
  ingested_at AS source_ingested_at,
  run_id AS source_run_id
FROM ${ref(dataform.projectConfig.vars.environment + "_bronze", "pedidos")}
${when(
  incremental(),
  `WHERE ingested_at >= (
    SELECT COALESCE(MAX(source_ingested_at), TIMESTAMP("1970-01-01"))
    FROM ${self()}
  )`,
  ""
)}
