config {
  type: "incremental",
  schema: "dev_silver",
  name: "envios",
  uniqueKey: ["envio_id"],
  tags: ["silver", "fact-shipments"],
  bigquery: {
    partitionBy: "DATE(criado_em)",
    clusterBy: ["pedido_id", "status_envio"]
  },
  assertions: {
    uniqueKey: ["envio_id"]
  }
}

SELECT
  envio_id,
  pedido_id,
  armazem_id,
  transportadora,
  CASE
    WHEN codigo_rastreamento IS NULL OR TRIM(codigo_rastreamento) = '' THEN NULL
    ELSE CONCAT('***', RIGHT(TRIM(codigo_rastreamento), 4))
  END AS codigo_rastreamento_mascarado,
  status_envio,
  enviado_em,
  entregue_em,
  custo_frete,
  criado_em,
  ingested_at AS source_ingested_at,
  run_id AS source_run_id
FROM ${ref("dev_bronze", "envios")}
${when(
  incremental(),
  `WHERE ingested_at >= (
    SELECT COALESCE(MAX(source_ingested_at), TIMESTAMP("1970-01-01"))
    FROM ${self()}
  )`,
  ""
)}
